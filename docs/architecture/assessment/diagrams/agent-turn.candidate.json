 "cards": [
  {
   "dot": "cyan",
   "title": "Loop contract",
   "items": [
    "Bounded by max_iterations and the iteration budget, plus one grace call",
    "Each phase returns a verdict: return, break, continue or fall through"
   ]
  },
  {
   "dot": "rose",
   "title": "Invariants to keep",
   "items": [
    "System prompt is byte-stable; compaction is the only cache break",
    "Tool call is persisted before it executes (resume safety)",
    "Fallback activation re-runs the preflight against the new context window"
   ]
  },
  {
   "dot": "amber",
   "title": "Coupling inside the loop",
   "items": [
    "MoA, Nous billing, Copilot, Ollama, voice and codex-app-server paths live in loop phases",
    "codex_app_server mode hands the whole turn to a subprocess"
   ]
  }
 ]
